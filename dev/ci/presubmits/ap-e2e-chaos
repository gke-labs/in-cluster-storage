set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

ARTIFACTS="${ARTIFACTS:-${REPO_ROOT}/.artifacts}"
mkdir -p "${ARTIFACTS}/test-results/go"

if [[ "${GOTOOLCHAIN:-}" == "local" || -z "${GOTOOLCHAIN:-}" ]]; then
  export GOTOOLCHAIN=auto
fi

RUN_E2E=1 go test -v -count=1 -timeout 17m -run '^(TestObjectFSControllerCrashMidWriteE2E|TestObjectFSControllerOutageE2E|TestObjectFSWalBufferRestartE2E)$' -json ./tests/e2e/ | \
  tee "${ARTIFACTS}/test-results/go/e2e-chaos.json" | \
  go run gotest.tools/gotestsum@v1.13.0 --format testname --raw-command cat
