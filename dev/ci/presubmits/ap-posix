set -o errexit
set -o nounset
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# pjdfstest requires root privileges to test syscalls with setuid/setgid (-u / -g).
if [[ "${EUID}" -ne 0 ]] && command -v sudo >/dev/null 2>&1; then
  exec sudo -E env "PATH=${PATH}" "HOME=${HOME}" "$0" "$@"
fi

# Install fuse3 in CI if missing.
if ! command -v fusermount3 >/dev/null 2>&1 && ! command -v fusermount >/dev/null 2>&1; then
  echo "Installing fuse3 dependencies..."
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update -qq
    apt-get install -y -qq fuse3 libfuse3-dev
  fi
fi

WORK_DIR="$(mktemp -d /tmp/posix-gate.XXXXXX)"
DEV_DIR="$(mktemp -d /tmp/objectfs-posix.XXXXXX)"
export OBJECTFS_DEV_DIR="${DEV_DIR}"

cleanup() {
  local exit_code=$?
  if [[ ${exit_code} -ne 0 ]]; then
    ARTIFACTS_DIR="${ARTIFACTS:-${REPO_ROOT}/.artifacts}"
    mkdir -p "${ARTIFACTS_DIR}"
    cp -f "${DEV_DIR}/controller.log" "${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f "${DEV_DIR}/mount.log" "${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f "${DEV_DIR}/mnt/fsx-test.bin.fsxops" "${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f "${DEV_DIR}/mnt/fsx-test.bin.fsxgood" "${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f fsx-test.bin.fsxops "${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f fsx-test.bin.fsxgood "${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f core* "${ARTIFACTS_DIR}/" 2>/dev/null || true

    echo "======= DUMPING CONTROLLER LOG (last 5000 lines) ======="
    if [[ -f "${DEV_DIR}/controller.log" ]]; then
      tail -n 5000 "${DEV_DIR}/controller.log"
    elif [[ -f "${ARTIFACTS_DIR}/controller.log" ]]; then
      tail -n 5000 "${ARTIFACTS_DIR}/controller.log"
    fi
    echo "======= DUMPING NODE DAEMON / MOUNT LOG (last 5000 lines) ======="
    if [[ -f "${DEV_DIR}/mount.log" ]]; then
      tail -n 5000 "${DEV_DIR}/mount.log"
    elif [[ -f "${ARTIFACTS_DIR}/mount.log" ]]; then
      tail -n 5000 "${ARTIFACTS_DIR}/mount.log"
    fi
    if [[ -f "${ARTIFACTS_DIR}/fsx-test.bin.fsxops" ]]; then
      echo "======= DUMPING FSX OPS LOG (last 5000 lines) ======="
      tail -n 5000 "${ARTIFACTS_DIR}/fsx-test.bin.fsxops"
    elif [[ -f "${DEV_DIR}/mnt/fsx-test.bin.fsxops" ]]; then
      echo "======= DUMPING FSX OPS LOG (last 5000 lines) ======="
      tail -n 5000 "${DEV_DIR}/mnt/fsx-test.bin.fsxops"
    fi
    echo "==============================================="
  fi
  rm -rf "${WORK_DIR}" "${DEV_DIR}"
}
trap cleanup EXIT

PJDFSTEST_DIR="${WORK_DIR}/pjdfstest"
PJDFSTEST_COMMIT="85a8aea9e685999ef0540392fd80535f873d7ff7"
echo "Fetching pjdfstest at commit ${PJDFSTEST_COMMIT}..."
git clone --quiet https://github.com/pjd/pjdfstest.git "${PJDFSTEST_DIR}"
(
  cd "${PJDFSTEST_DIR}"
  git checkout --quiet "${PJDFSTEST_COMMIT}"
  cat << 'EOF' > config.h
#define _GNU_SOURCE 1
#define HAVE_SYS_SYSMACROS_H 1
#define HAVE_FACCESSAT 1
#define HAVE_FCHMODAT 1
#define HAVE_FCHOWNAT 1
#define HAVE_FSTATAT 1
#define HAVE_LINKAT 1
#define HAVE_MKDIRAT 1
#define HAVE_MKFIFOAT 1
#define HAVE_MKNODAT 1
#define HAVE_OPENAT 1
#define HAVE_POSIX_FALLOCATE 1
#define HAVE_READLINKAT 1
#define HAVE_RENAMEAT 1
#define HAVE_SYMLINKAT 1
#define HAVE_UTIMENSAT 1
#define HAVE_STRUCT_STAT_ST_ATIM 1
#define HAVE_STRUCT_STAT_ST_CTIM 1
#define HAVE_STRUCT_STAT_ST_MTIM 1
EOF
  gcc -Wall -O2 -I. -o pjdfstest pjdfstest.c
)

XFSTESTS_DIR="${WORK_DIR}/xfstests"
mkdir -p "${XFSTESTS_DIR}"
"${REPO_ROOT}/dev/tasks/build-fsx" "${XFSTESTS_DIR}/fsx"

echo "Compiling mmap shared write coherency test..."
gcc -Wall -O2 -o "${WORK_DIR}/test_mmap" "${REPO_ROOT}/tests/posix/test_mmap.c"

RUNNER_SCRIPT="${WORK_DIR}/run-tests.sh"
EXPECTED_FAILURES_FILE="${REPO_ROOT}/tests/posix/expected-failures.txt"

cat << EOF > "${RUNNER_SCRIPT}"
#!/bin/bash
set -o errexit
set -o nounset
set -o pipefail

echo "==> Verifying filesystem statistics with df -k..."
df -k .
df_out=\$(df -k .)
data_line=\$(echo "\${df_out}" | tail -n 1)
blocks=\$(echo "\${data_line}" | awk '{print \$2}')
avail=\$(echo "\${data_line}" | awk '{print \$4}')
echo "Mount stats: Blocks=\${blocks} (1K blocks), Available=\${avail} (1K blocks)"
if [[ -z "\${blocks}" || "\${blocks}" -le 0 ]]; then
  echo "ERROR: df -k reported invalid or zero blocks: \${blocks}"
  exit 1
fi
if [[ -z "\${avail}" || "\${avail}" -le 0 ]]; then
  echo "ERROR: df -k reported invalid or non-positive available space: \${avail}"
  exit 1
fi
echo "Filesystem statistics verified: df -k returned non-zero Blocks and sane Available space."
echo

echo "==> Running fsx data-integrity test across multiple seeds..."
# File size limit raised well above 1MB (16MB) using 64 KiB chunked blob-first writes (#143).
# Mapped writes are enabled (#269).
# Fallocate, punch-hole, and zero-range are enabled (#268).
# Collapse (-C), insert (-I), exchange (-0), dedupe (-B), clone (-J), and copy range (-E) remain disabled.
FSX_SEEDS=(42 1337 2026 777 9999)
for seed in "\${FSX_SEEDS[@]}"; do
  echo "--- fsx run (seed=\${seed}, 1000 ops) ---"
  set +o errexit
  "${XFSTESTS_DIR}/fsx" -N 1000 -S "\${seed}" -l 16777216 -o 65536 -p 200 -C -I -0 -B -J -E fsx-test.bin
  fsx_exit=\$?
  set -o errexit
  if [[ \${fsx_exit} -ne 0 ]]; then
    echo "fsx failed on seed \${seed} with exit code \${fsx_exit}"
    ARTIFACTS_DIR="\${ARTIFACTS:-${REPO_ROOT}/.artifacts}"
    mkdir -p "\${ARTIFACTS_DIR}"
    cp -f fsx-test.bin.fsxops "\${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f fsx-test.bin.fsxgood "\${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f "${DEV_DIR}/controller.log" "\${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f "${DEV_DIR}/mount.log" "\${ARTIFACTS_DIR}/" 2>/dev/null || true
    cp -f core* "\${ARTIFACTS_DIR}/" 2>/dev/null || true
    exit \${fsx_exit}
  fi
  rm -f fsx-test.bin fsx-test.bin.fsxops fsx-test.bin.fsxgood
done
echo "fsx passed successfully across all seeds!"
echo

echo "==> Running mmap shared write coherency test..."
"${WORK_DIR}/test_mmap" .
echo "mmap shared write coherency test: PASS"
echo

echo "==> Running pjdfstest POSIX conformance test suite..."
PJDFSTEST_TESTS_DIR="${PJDFSTEST_DIR}/tests"
EXPECTED_FAILURES="${EXPECTED_FAILURES_FILE}"

# Known flaky tests allowed to either pass or fail without failing the gate
KNOWN_FLAKY=" open/25.t "

expected_failures_map=""
while IFS= read -r line || [[ -n "\${line}" ]]; do
  # Strip comments and whitespace
  line="\$(echo "\${line}" | sed 's/#.*//' | xargs)"
  if [[ -n "\${line}" ]]; then
    expected_failures_map="\${expected_failures_map} \${line} "
  fi
done < "\${EXPECTED_FAILURES}"

total_count=0
expected_pass_count=0
expected_fail_count=0
unexpected_pass_list=()
unexpected_fail_list=()

for test_file in \$(find "\${PJDFSTEST_TESTS_DIR}" -name "*.t" | sort); do
  t_rel="\${test_file#\${PJDFSTEST_TESTS_DIR}/}"
  total_count=\$((total_count + 1))

  set +o errexit
  output=\$(/bin/sh "\${test_file}" 2>&1)
  exit_code=\$?
  set -o errexit

  passed=0
  if [[ \${exit_code} -eq 0 ]]; then
    if printf '%s\n' "\${output}" | grep "^not ok" | grep -v -E "# (TODO|SKIP)" >/dev/null 2>&1; then
      passed=0
    elif printf '%s\n' "\${output}" | grep "^ok" >/dev/null 2>&1; then
      passed=1
    fi
  fi

  is_expected_fail=0
  if [[ "\${expected_failures_map}" =~ " \${t_rel} " ]]; then
    is_expected_fail=1
  fi
  is_flaky=0
  if [[ "\${KNOWN_FLAKY}" =~ " \${t_rel} " ]]; then
    is_flaky=1
  fi

  if [[ \${passed} -eq 1 ]]; then
    if [[ \${is_expected_fail} -eq 1 ]]; then
      if [[ \${is_flaky} -eq 0 ]]; then
        unexpected_pass_list+=("\${t_rel}")
      else
        expected_pass_count=\$((expected_pass_count + 1))
      fi
    else
      expected_pass_count=\$((expected_pass_count + 1))
    fi
  else
    if [[ \${is_expected_fail} -eq 1 ]]; then
      expected_fail_count=\$((expected_fail_count + 1))
    else
      if [[ \${is_flaky} -eq 0 ]]; then
        unexpected_fail_list+=("\${t_rel}")
      else
        expected_fail_count=\$((expected_fail_count + 1))
      fi
    fi
  fi
done

echo
echo "============================================================"
echo "POSIX & Data-Integrity Conformance Summary:"
echo "------------------------------------------------------------"
echo "  fsx data-integrity test: PASS (5 seeds, 1000 ops each, max_len=16MB, mapped writes enabled)"
echo "  mmap coherency test:     PASS (4 suites: basic, size preservation, interleaving, dirty page truncated away)"
echo "------------------------------------------------------------"
echo "  pjdfstest POSIX test suite:"
echo "    Total tests executed:  \${total_count}"
echo "    Passed (expected):     \${expected_pass_count}"
echo "    Failed (expected):     \${expected_fail_count}"
echo "    Unexpected passes:     \${#unexpected_pass_list[@]}"
echo "    Unexpected failures:   \${#unexpected_fail_list[@]}"
echo "============================================================"

if [[ \${#unexpected_pass_list[@]} -gt 0 ]]; then
  echo
  echo "ERROR: The following tests passed but are listed in \${EXPECTED_FAILURES}."
  echo "Please remove them from expected-failures.txt to shrink the expected failures list:"
  for t in "\${unexpected_pass_list[@]}"; do
    echo "  - \${t}"
  done
fi

if [[ \${#unexpected_fail_list[@]} -gt 0 ]]; then
  echo
  echo "ERROR: The following tests failed unexpectedly (regression):"
  for t in "\${unexpected_fail_list[@]}"; do
    echo "  - \${t}"
  done
fi

if [[ \${#unexpected_pass_list[@]} -gt 0 || \${#unexpected_fail_list[@]} -gt 0 ]]; then
  exit 1
fi

echo "POSIX and data-integrity tests passed all expectations!"
EOF

chmod +x "${RUNNER_SCRIPT}"

# Execute tests against native FUSE mount in configured mode with debug mutation checking enabled
echo "=== Running POSIX gate (${OBJECTFS_METADATA_INDEX:-sqlite} metadata store with debug mutation check) ==="
GOTOOLCHAIN=auto OBJECTFS_METADATA_INDEX="${OBJECTFS_METADATA_INDEX:-sqlite}" OBJECTFS_CONTROLLER_ARGS="--debug-mutation-check" OBJECTFS_MOUNT_ARGS="--debug" ./dev/tasks/fuse-start -- "${RUNNER_SCRIPT}"
